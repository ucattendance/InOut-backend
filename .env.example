PORT=5000
MONGO_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/DATABASE?retryWrites=true&w=majority
JWT_SECRET=replace-with-a-long-random-string

# Optional: override 3-day profile grace window (ms). Default = 259200000 (3 days).
# PROFILE_INCOMPLETE_GRACE_MS=259200000

# Optional (email / uploads)
NOTIFY_EMAIL=
NOTIFY_PASSWORD=

# Attendance reminder emails (Asia/Kolkata cron). Set to false to disable.
# ATTENDANCE_REMINDERS_ENABLED=true

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
ASKEVA_API_KEY=
